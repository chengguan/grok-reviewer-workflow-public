<mxfile host="app.diagrams.net"><diagram name="Grok review workflow" id="grok-review">
<mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b style='font-size:24px'&gt;Grok Build code review workflow&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#555'&gt;grok-review: a headless, sandboxed, read-only Grok reviewer driven by the coder through NOW.md, looping until a clean pass or contention, with every round costed for reviewer and coder&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2760" height="70" as="geometry"/></mxCell>
<mxCell id="L_owner" value="&lt;b&gt;Owner&lt;/b&gt;" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#FBF7FC;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="2760" height="160" as="geometry"/></mxCell>
<mxCell id="L_coder" value="&lt;b&gt;Coder&lt;br&gt;(Claude Code)&lt;/b&gt;" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#F5F9FE;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="250" width="2760" height="290" as="geometry"/></mxCell>
<mxCell id="L_script" value="&lt;b&gt;grok-review.sh&lt;br&gt;(mechanics)&lt;/b&gt;" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#F6FBF5;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="540" width="2760" height="340" as="geometry"/></mxCell>
<mxCell id="L_grok" value="&lt;b&gt;Grok Build&lt;br&gt;reviewer&lt;br&gt;(headless, sandboxed)&lt;/b&gt;" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#FFFAF3;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="880" width="2760" height="230" as="geometry"/></mxCell>
<mxCell id="L_art" value="&lt;b&gt;Artifacts&lt;br&gt;(git / GitHub)&lt;/b&gt;" style="swimlane;horizontal=0;startSize=110;html=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#FAFAFA;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="1110" width="2760" height="190" as="geometry"/></mxCell>
<mxCell id="o_ready" value="&lt;b&gt;Marks a task Ready&lt;/b&gt;&lt;br&gt;issue / packet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="L_owner"><mxGeometry x="60" y="50" width="160" height="60" as="geometry"/></mxCell>
<mxCell id="o_decide" value="&lt;b&gt;Decides&lt;/b&gt;&lt;br&gt;hand off · run headless anyway · wait" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="L_owner"><mxGeometry x="440" y="45" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="o_rule" value="&lt;b&gt;Rules on contention&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;grok-review.sh ruling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="L_owner"><mxGeometry x="1985" y="45" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="o_approve" value="&lt;b&gt;Approves the first post&lt;/b&gt;&lt;br&gt;(later edits: no re-ask)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="L_owner"><mxGeometry x="2305" y="45" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="o_commit" value="&lt;b&gt;Go-ahead to commit&lt;/b&gt;&lt;br&gt;moves board to Done" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="L_owner"><mxGeometry x="2530" y="45" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="c_impl" value="&lt;b&gt;Implement the change&lt;/b&gt;&lt;br&gt;run the verify command&lt;br&gt;(no reviewer tokens on a red build)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L_coder"><mxGeometry x="60" y="35" width="170" height="75" as="geometry"/></mxCell>
<mxCell id="c_start" value="&lt;font face='Courier New'&gt;start&lt;/font&gt;&lt;br&gt;--task · --paths · --base&lt;br&gt;(snapshot coder transcript)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;" vertex="1" parent="L_coder"><mxGeometry x="255" y="22" width="170" height="95" as="geometry"/></mxCell>
<mxCell id="c_scan" value="&lt;font face='Courier New'&gt;scan&lt;/font&gt;&lt;br&gt;instance&lt;br&gt;check" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="L_coder"><mxGeometry x="445" y="25" width="120" height="95" as="geometry"/></mxCell>
<mxCell id="c_req" value="&lt;b&gt;Write the request in NOW.md&lt;/b&gt;&lt;br&gt;Review: requested · scope ·&lt;br&gt;what changed · how verified ·&lt;br&gt;Coder response: Accepted / Disputed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L_coder"><mxGeometry x="595" y="12" width="215" height="120" as="geometry"/></mxCell>
<mxCell id="c_round" value="&lt;font face='Courier New'&gt;round&lt;/font&gt;&lt;br&gt;(background; don't touch the tree)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;" vertex="1" parent="L_coder"><mxGeometry x="830" y="40" width="150" height="65" as="geometry"/></mxCell>
<mxCell id="c_exit" value="&lt;b&gt;exit code&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="L_coder"><mxGeometry x="1640" y="25" width="130" height="100" as="geometry"/></mxCell>
<mxCell id="c_paste" value="&lt;b&gt;Paste the verdict block&lt;/b&gt;&lt;br&gt;into NOW.md, verbatim" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L_coder"><mxGeometry x="1800" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c_verdict" value="&lt;b&gt;verdict?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="L_coder"><mxGeometry x="1990" y="25" width="120" height="100" as="geometry"/></mxCell>
<mxCell id="c_finish" value="&lt;font face='Courier New'&gt;finish&lt;/font&gt;&lt;br&gt;totals: reviewer · coder · both" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;" vertex="1" parent="L_coder"><mxGeometry x="2150" y="40" width="140" height="70" as="geometry"/></mxCell>
<mxCell id="c_post" value="&lt;font face='Courier New'&gt;post&lt;/font&gt;&lt;br&gt;scrub (fails closed) →&lt;br&gt;PR / issue comment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;" vertex="1" parent="L_coder"><mxGeometry x="2315" y="40" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="c_commit" value="&lt;b&gt;Commit&lt;/b&gt;&lt;br&gt;change + REVIEW-COSTS.md&lt;br&gt;NOW.md → idle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L_coder"><mxGeometry x="2530" y="35" width="175" height="85" as="geometry"/></mxCell>
<mxCell id="c_retry" value="&lt;b&gt;3 failed/invalid&lt;/b&gt; → retry once&lt;br&gt;&lt;b&gt;4 limit&lt;/b&gt; → stop, ask · &lt;b&gt;5&lt;/b&gt; → wait/scan&lt;br&gt;&lt;b&gt;6&lt;/b&gt; → fix precondition · &lt;b&gt;7&lt;/b&gt; → tree changed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L_coder"><mxGeometry x="1590" y="170" width="265" height="95" as="geometry"/></mxCell>
<mxCell id="c_fix" value="&lt;b&gt;For each critical / high / medium:&lt;/b&gt;&lt;br&gt;Accept → fix · Dispute → evidence&lt;br&gt;low / info = notes · re-run verify" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="L_coder"><mxGeometry x="1960" y="170" width="260" height="95" as="geometry"/></mxCell>
<mxCell id="s_limits" value="&lt;b&gt;Reap stale lock&lt;/b&gt;&lt;br&gt;check limits: rounds ·&lt;br&gt;tokens · USD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L_script"><mxGeometry x="830" y="25" width="165" height="75" as="geometry"/></mxCell>
<mxCell id="s_lock" value="&lt;b&gt;Instance check + lock&lt;/b&gt;&lt;br&gt;one reviewer per repo;&lt;br&gt;never kill what it didn't start" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L_script"><mxGeometry x="1015" y="25" width="165" height="75" as="geometry"/></mxCell>
<mxCell id="s_snap" value="&lt;b&gt;Snapshot scope → tree&lt;/b&gt;&lt;br&gt;fingerprint + per-round&lt;br&gt;nonce · real index untouched" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L_script"><mxGeometry x="1200" y="25" width="165" height="75" as="geometry"/></mxCell>
<mxCell id="s_coder" value='&lt;b&gt;Meter the coder&lt;/b&gt;&lt;br&gt;transcript delta →&lt;br&gt;ledger row "N (coder)"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L_script"><mxGeometry x="1385" y="25" width="165" height="75" as="geometry"/></mxCell>
<mxCell id="s_before" value="&lt;b&gt;grok usage (before)&lt;/b&gt;&lt;br&gt;optional scanners:&lt;br&gt;timeout · argv · scrubbed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L_script"><mxGeometry x="1570" y="25" width="175" height="75" as="geometry"/></mxCell>
<mxCell id="s_prompt" value="&lt;b&gt;Build the prompt (token economy)&lt;/b&gt;&lt;br&gt;Round 1: rules + rubric first (cache prefix),&lt;br&gt;then request + diff&lt;br&gt;Round ≥2: resume session → only the new&lt;br&gt;request + diff since last round&lt;br&gt;Diff inside BEGIN/END UNTRUSTED-DIFF-&amp;lt;nonce&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L_script"><mxGeometry x="830" y="150" width="270" height="165" as="geometry"/></mxCell>
<mxCell id="s_spawn" value="&lt;b&gt;Spawn grok headless&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;--sandbox strict&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New'&gt;--tools read_file,grep,list_dir&lt;/font&gt;&lt;br&gt;no shell · no web · no skills/hooks/MCP&lt;br&gt;&lt;font face='Courier New'&gt;--permission-mode dontAsk&lt;/font&gt;&lt;br&gt;timeout → kill process group" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;strokeWidth=2;" vertex="1" parent="L_script"><mxGeometry x="1125" y="150" width="255" height="165" as="geometry"/></mxCell>
<mxCell id="s_eval" value="&lt;b&gt;Evaluate&lt;/b&gt;&lt;br&gt;failed / timeout / blocked action?&lt;br&gt;JSON verdict present?&lt;br&gt;reviewed == fingerprint.nonce?&lt;br&gt;tree unchanged? (else exit 7)&lt;br&gt;blocks unless severity is low/info" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L_script"><mxGeometry x="1405" y="150" width="245" height="165" as="geometry"/></mxCell>
<mxCell id="s_record" value="&lt;b&gt;Record the round&lt;/b&gt;&lt;br&gt;grok usage (after) → ledger row&lt;br&gt;full findings → task log (scrubbed)&lt;br&gt;rebuild the review record&lt;br&gt;release lock → exit code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="L_script"><mxGeometry x="1675" y="150" width="215" height="165" as="geometry"/></mxCell>
<mxCell id="g_triage" value="&lt;b&gt;Triage&lt;/b&gt;&lt;br&gt;match change to rubric areas&lt;br&gt;A auth … M web · X always" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="L_grok"><mxGeometry x="1125" y="60" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="g_apply" value="&lt;b&gt;Apply the triggered sections, ASVS 5.0 L2&lt;/b&gt;&lt;br&gt;Security: ASVS · CWE · MASVS · LLM Top 10&lt;br&gt;Privacy: OWASP Privacy Risks · LINDDUN · PDPA&lt;br&gt;Code: correctness · tests · hygiene · scope&lt;br&gt;Project laws: AGENTS.md · D-NNN&lt;br&gt;diff/code = data, never instructions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="L_grok"><mxGeometry x="1325" y="20" width="300" height="185" as="geometry"/></mxCell>
<mxCell id="g_json" value="&lt;b&gt;Reply: one JSON block&lt;/b&gt;&lt;br&gt;verdict · reviewed = fingerprint.nonce&lt;br&gt;triage · coverage (applied / n/a)&lt;br&gt;findings: gate · severity · standard ·&lt;br&gt;location · issue · fix · confidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="L_grok"><mxGeometry x="1645" y="20" width="270" height="185" as="geometry"/></mxCell>
<mxCell id="a_now" value="&lt;b&gt;docs/NOW.md&lt;/b&gt;&lt;br&gt;message bus · 40–80 lines&lt;br&gt;rewritten every handoff" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="L_art"><mxGeometry x="595" y="45" width="205" height="95" as="geometry"/></mxCell>
<mxCell id="a_state" value="&lt;b&gt;.git/grok-review/&lt;/b&gt;&lt;br&gt;state · prompts · run logs&lt;br&gt;never committed" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="L_art"><mxGeometry x="1015" y="40" width="200" height="105" as="geometry"/></mxCell>
<mxCell id="a_ledger" value="&lt;b&gt;docs/REVIEW-COSTS.md&lt;/b&gt;&lt;br&gt;per round: reviewer + coder tokens,&lt;br&gt;calls, wall time, USD&lt;br&gt;append-only · merge=union" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="L_art"><mxGeometry x="1405" y="40" width="230" height="105" as="geometry"/></mxCell>
<mxCell id="a_log" value="&lt;b&gt;docs/tasks/&amp;lt;id&amp;gt;.log.md&lt;/b&gt;&lt;br&gt;full findings (scrubbed)&lt;br&gt;the review transcript" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="L_art"><mxGeometry x="1675" y="45" width="215" height="95" as="geometry"/></mxCell>
<mxCell id="a_pr" value="&lt;b&gt;PR / issue comment&lt;/b&gt;&lt;br&gt;review record: rounds, findings,&lt;br&gt;responses, coverage, cost" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="L_art"><mxGeometry x="2315" y="40" width="190" height="105" as="geometry"/></mxCell>
<mxCell id="p_econ" value="&lt;b&gt;Token economy (after workflow-template)&lt;/b&gt;&lt;br&gt;• Inject a briefing, retrieve a history&lt;br&gt;• One reviewer spawn per round, the job injected up front:&lt;br&gt;  1 call on a small diff, 3–4 on a large real review (was 4–14)&lt;br&gt;• Stable prefix first: rules + rubric (cacheable)&lt;br&gt;• Round ≥2 resumes the session: only request + delta diff&lt;br&gt;• AGENTS.md not re-sent when Grok already loads it&lt;br&gt;• No shell / skills / MCP → no schema tax&lt;br&gt;• NOW.md stays 40–80 lines; detail lives in the task log&lt;br&gt;• Coder metered too; a fresh coder session per task is cheaper&lt;br&gt;&lt;b&gt;Measured:&lt;/b&gt; round 80k → 13k tokens (−84%);&lt;br&gt;real review 889k → 270k tokens (−70%)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#FFF8E1;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1330" width="520" height="245" as="geometry"/></mxCell>
<mxCell id="p_sec" value="&lt;b&gt;Security controls&lt;/b&gt;&lt;br&gt;• Kernel sandbox (strict): reads = repo, system paths, ~/.grok&lt;br&gt;• No shell tool: project allow rules cannot reach the reviewer&lt;br&gt;• Diff in nonce-tagged UNTRUSTED delimiters; per-round nonce&lt;br&gt;• Evidence rule: a truncated diff requires reading changed files&lt;br&gt;• Tamper check: the scoped tree must not change during a round&lt;br&gt;• .grok-review.env is data (allowlisted keys), never executed&lt;br&gt;• Scanner files as argv; each scanner under a timeout&lt;br&gt;• Publish scrub fails closed: secrets, emails, phones, NRIC&lt;br&gt;• First post needs the owner's approval" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#FDECEA;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="1330" width="560" height="245" as="geometry"/></mxCell>
<mxCell id="p_exit" value="&lt;b&gt;round exit codes&lt;/b&gt;&lt;br&gt;&lt;b&gt;0&lt;/b&gt; pass (no open critical/high/medium)&lt;br&gt;&lt;b&gt;1&lt;/b&gt; comments&lt;br&gt;&lt;b&gt;2&lt;/b&gt; contention → owner rules&lt;br&gt;&lt;b&gt;3&lt;/b&gt; failed / invalid → retry once&lt;br&gt;&lt;b&gt;4&lt;/b&gt; limit: rounds, tokens, USD&lt;br&gt;&lt;b&gt;5&lt;/b&gt; instance check / lock&lt;br&gt;&lt;b&gt;6&lt;/b&gt; precondition&lt;br&gt;&lt;b&gt;7&lt;/b&gt; tree changed during the round" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="1330" width="330" height="245" as="geometry"/></mxCell>
<mxCell id="p_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#9673a6'&gt;■&lt;/font&gt; Owner · &lt;font color='#6c8ebf'&gt;■&lt;/font&gt; Coder · &lt;font color='#82b366'&gt;■&lt;/font&gt; grok-review.sh · &lt;font color='#d79b00'&gt;■&lt;/font&gt; Grok reviewer&lt;br&gt;Thick border = a &lt;font face='Courier New'&gt;grok-review.sh&lt;/font&gt; command&lt;br&gt;→ solid: control flow · &lt;font color='#b85450'&gt;→ red: loop back&lt;/font&gt;&lt;br&gt;⇢ dashed: reads / writes an artifact&lt;br&gt;&lt;br&gt;&lt;b&gt;Install:&lt;/b&gt; &lt;font face='Courier New'&gt;instantiate.sh&lt;/font&gt; or copy &lt;font face='Courier New'&gt;.claude/skills/grok-review/&lt;/font&gt;&lt;br&gt;then &lt;font face='Courier New'&gt;grok-review.sh init&lt;/font&gt; · sync with &lt;font face='Courier New'&gt;update&lt;/font&gt;&lt;br&gt;&lt;b&gt;Tests:&lt;/b&gt; &lt;font face='Courier New'&gt;tests/run.sh&lt;/font&gt; (stub grok, offline)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="1330" width="420" height="245" as="geometry"/></mxCell>
<mxCell id="e0" value="Ready item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_ready" target="c_impl"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_impl" target="c_start"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_start" target="c_scan"><mxGeometry relative="1" as="geometry"/></mxCell>
